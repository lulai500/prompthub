# ============================================================
# PromptHub - 环境变量模板
# 复制此文件为 .env.local 并填入真实值
# ============================================================

# Supabase 配置（必填）
# 在 Supabase Dashboard → Settings → API 获取
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key（服务端使用，具有最高权限）
# ⚠️ 绝对不要暴露到前端！仅在 API Route / Server Component 中使用
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# DeepSeek API Key（客户工作站 AI 执行用）
# 在 https://platform.deepseek.com/api_keys 获取；未配置时工作站降级为"组装方案"
DEEPSEEK_API_KEY=your-deepseek-api-key

# 网站基础 URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# GitHub 仓库地址（开源项目链接）
# 如果未设置，默认使用 https://github.com 占位链接
NEXT_PUBLIC_GITHUB_URL=https://github.com/your-org/prompthub

# ============================================================
# Newsletter 订阅（可选）
# 配置后订阅者会同步到 Buttondown 并收到周报；未配置则仅存入 Supabase 表
# 在 https://buttondown.com/settings/api 获取 API Token
# ============================================================
BUTTONDOWN_API_KEY=your-buttondown-api-token

# ============================================================
# Lemon Squeezy 支付配置（付费功能暂未启用，预置配置）
# 后续启用付费时，在 https://app.lemonsqueezy.com/settings/api 获取
# ============================================================
LEMON_SQUEEZY_API_KEY=your-lemon-squeezy-api-key
LEMON_SQUEEZY_WEBHOOK_SECRET=your-webhook-signing-secret
LEMON_SQUEEZY_STORE_ID=your-store-id

# Lemon Squeezy 产品 Variant ID（在 Lemon Squeezy 后台创建产品后获取）
LEMON_SQUEEZY_VARIANT_MONTHLY=variant-id-monthly
LEMON_SQUEEZY_VARIANT_QUARTERLY=variant-id-quarterly
LEMON_SQUEEZY_VARIANT_YEARLY=variant-id-yearly
